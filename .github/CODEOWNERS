/.github/                        @TrayambakMaintainers
/.gitleaks.toml                  @TrayambakMaintainers
/Dockerfile                      @TrayambakMaintainers

# ─── Agent loop / approval / audit (changes require harness tests) ───
/apps/runtime/src/agent/         @TrayambakMaintainers
/packages/core/src/approval.ts   @TrayambakMaintainers
/packages/core/src/audit_log.ts  @TrayambakMaintainers
/packages/core/src/state_db.ts   @TrayambakMaintainers
/packages/protocol/src/permission-rules.ts @TrayambakMaintainers

