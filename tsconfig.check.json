{
  // Check-only twin of tsconfig.json (same include/exclude via extends):
  // `npm run typecheck` points here so the check can be `incremental`
  // (full cold check ~5s → warm ~1-2s) WITHOUT touching the emitting
  // build — incremental + emit proved unsafe (deleted dist/ outputs were
  // never regenerated). Separate buildinfo so this never races the build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuild/main.check.tsbuildinfo"
  }
}
