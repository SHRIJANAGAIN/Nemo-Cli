{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trayambak Config",
  "type": "object",
  "properties": {
    "baseUrl": { "type": "string" },
    "model": { "type": "string" },
    "apiKey": { "type": "string" },
    "provider": {
      "type": "string",
      "enum": [
        "llamacpp",
        "nvidia",
        "nvidia-nim",
        "openai",
        "xai",
        "huggingface",
        "anthropic",
        "google",
        "ollama",
        "custom"
      ]
    },
    "cwd": { "type": "string" },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "maxTokens": { "type": "number" },
    "timeoutMs": { "type": "number" },
    "maxTurns": { "type": "number" },
    "maxToolCalls": { "type": "number" }
  }
}
