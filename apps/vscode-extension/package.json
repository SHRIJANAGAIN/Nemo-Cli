{
  "name": "trayambak-vscode",
  "displayName": "Trayambak",
  "description": "Trayambak terminal agent in VS Code (sidebar webview + commands).",
  "version": "0.7.0",
  "publisher": "SKT-AI-LABS",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trayambak",
          "title": "Trayambak",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "trayambak": [
        {
          "id": "trayambak.sidebar",
          "name": "Trayambak"
        },
        {
          "id": "trayambak.sessions",
          "name": "Sessions"
        },
        {
          "id": "trayambak.models",
          "name": "Models"
        }
      ]
    },
    "commands": [
      {
        "command": "trayambak.run",
        "title": "Trayambak: Run prompt"
      },
      {
        "command": "trayambak.openWeb",
        "title": "Trayambak: Open web UI"
      },
      {
        "command": "trayambak.switchModel",
        "title": "Trayambak: Switch model"
      },
      {
        "command": "trayambak.switchProvider",
        "title": "Trayambak: Switch provider"
      },
      {
        "command": "trayambak.compact",
        "title": "Trayambak: Compact session"
      },
      {
        "command": "trayambak.review",
        "title": "Trayambak: Review selection"
      },
      {
        "command": "trayambak.newSession",
        "title": "Trayambak: New session"
      },
      {
        "command": "trayambak.openSessions",
        "title": "Trayambak: Open sessions"
      }
    ],
    "configuration": {
      "title": "Trayambak",
      "properties": {
        "trayambak.provider": {
          "type": "string",
          "default": "nvidia",
          "description": "Model provider backend (22 backends: llamacpp/nvidia/openai/anthropic/google/ollama/groq/mistral/openrouter/...)."
        },
        "trayambak.model": {
          "type": "string",
          "default": "",
          "description": "Model id for the active provider. Empty = provider default."
        },
        "trayambak.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Provider base URL override. Empty = provider default."
        },
        "trayambak.telemetry": {
          "type": "string",
          "enum": [
            "off",
            "on"
          ],
          "default": "off",
          "description": "Telemetry is off by default; no prompts."
        },
        "trayambak.inlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Ghost-text inline completion from local context (no network by default)."
        }
      }
    },
    "keybindings": [
      {
        "command": "trayambak.run",
        "key": "ctrl+shift+t",
        "title": "Trayambak: Run prompt"
      },
      {
        "command": "trayambak.switchModel",
        "key": "ctrl+shift+m",
        "title": "Trayambak: Switch model"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "typescript": "^5.4.0",
    "vitest": "2.1.9"
  }
}
