# Compiled output (rebuilt by `npm run build`; publish/ is regenerated)
dist/
publish/
*.tsbuildinfo
sbom.cyclonedx.json

# State databases
state/
state/*.sqlite
state/*.sqlite-wal
state/*.sqlite-shm

# Violation logs
violations.jsonl
state/violations.jsonl
state/logs_2.sqlite
state/goals_1.sqlite
state/memories_1.sqlite
state/queue_1.sqlite
state/thread_history_1.sqlite

# Test/coverage artifacts
coverage/
.smoke-cov/

# Dependencies
node_modules/

# Local session / state (per-project + per-user)
.nemo/
*.log
.cline-*
backend-handlers/

# Private self-improvement journal (user state; never committed, never published)
nemo/1-errors/mistakes.json

# Session conversation transcripts (machine-written runtime state)
nemo/8-conversations/

# Backups & scratch (never commit)
backups/
*.bak
.smoke-tmp/
.scratchpad/

# One-off Windows batch helpers parked at the repo root (local convenience
# only — never committed; the supported entry points are package.json scripts)
*.bat

# Prebuilt llama.cpp Windows binaries in bin/ (large, third-party;
# see bin/README.md for provenance & how to obtain)
bin/*.exe
bin/*.dll
bin/*.exp
bin/*.lib
bin/*.pdb

# Editor
.vscode/
.idea/
.DS_Store

# Secrets / local env (never commit)
.env
.env.*
*.pem
*.key

# Local license/key batches (live credentials — never commit, never push)
data/

# Corrupt-config forensics (kept locally, never committed)
*.corrupt-*

nemo/canary/

# Packed npm artifacts (npm pack output) -- never source
*.tgz
